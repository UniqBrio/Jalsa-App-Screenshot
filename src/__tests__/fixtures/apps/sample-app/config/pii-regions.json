{
  "$comment": [
    "Synthetic PII config for the Sample App fixture (fixtures/evidence-app.ts). Same shape as a real app's",
    "config/pii-regions.json: data_regions classify text by the element it sits in, label_texts are always L."
  ],
  "data_regions": [
    {
      "id": "org-header",
      "class": "O",
      "match": {
        "testid": "shell-org"
      }
    },
    {
      "id": "course-cards",
      "class": "P",
      "match": {
        "testid_family": "courses-open-*"
      }
    },
    {
      "id": "course-roster-links",
      "class": "P",
      "match": {
        "testid_family": "courses-roster-*"
      }
    },
    {
      "id": "course-edit-links",
      "class": "P",
      "match": {
        "testid_family": "courses-edit-*"
      }
    },
    {
      "id": "course-roster-rows",
      "class": "P",
      "match": {
        "role": "button",
        "name_regex": ", (active|inactive)\\. "
      }
    },
    {
      "id": "member-rows",
      "class": "P",
      "match": {
        "role": "button",
        "name_regex": " expected, "
      }
    },
    {
      "id": "member-record",
      "class": "P",
      "match": {
        "testid": "member-details"
      }
    },
    {
      "id": "course-branch-field",
      "class": "O",
      "match": {
        "testid": "course-branch-field"
      }
    },
    {
      "id": "course-template-field",
      "class": "O",
      "match": {
        "testid": "course-template-field"
      }
    },
    {
      "id": "account-card",
      "class": "I",
      "match": {
        "role": "button",
        "name_regex": "Open your profile"
      }
    }
  ],
  "label_texts": [
    "Welcome back",
    "Your number, then your 4-digit PIN.",
    "Continue",
    "Enter your PIN",
    "Change mobile number",
    "Forgot PIN?",
    "Overview",
    "Attendance",
    "Home",
    "Reports",
    "More",
    "Members",
    "Add",
    "All",
    "No email",
    "Needs follow-up",
    "Name, email or Meet alias",
    "NO EMAIL",
    "EMAIL OK",
    "No address on file",
    "Welcome a new member",
    "Joins a course at one branch",
    "MEMBER NAME",
    "COURSE",
    "BRANCH",
    "ACTIVE FROM",
    "Choose a course",
    "Choose a branch",
    "STATUS",
    "Active",
    "In the follow-up rule",
    "Cancel",
    "Add Member",
    "Member name and an email address are required"
  ]
}