# ─────────────────────────────────────────────────────────────────────────────
# Any-App Screenshot Capture — SHARED settings (every app)
#
# Copy to `.env` (gitignored). This file holds NO credentials and no app
# details: each app's URL, hosts, login and accounts live in
# apps/<app-id>/app.config.json, and its credentials in apps/<app-id>/.env
# (start from apps/_template/.env.example). Credentials set here are ignored.
# ─────────────────────────────────────────────────────────────────────────────

# --- Which app (optional) -----------------------------------------------------
# Usually passed per command instead: npm run capture -- --app <app-id>.
# There is no default — with neither, commands stop and list the profiles.
# APP=

# --- Devices -------------------------------------------------------------------
# Comma-separated ids from config/devices.json, or "all". Without it (and
# without --device / --all-devices) an interactive run asks; a scheduled one
# uses the "default" list in config/devices.json and says so.
# DEVICES=Mobile,Laptop

# --- Behaviour -----------------------------------------------------------------
# Prune runs/<app-id>/ entries older than this many days (0 = keep forever).
RUNS_RETENTION_DAYS=30
HEADLESS=true
# Overrides the profile's theme for the OS colour scheme the browser reports.
# COLOR_SCHEME=
SLOW_MO_MS=0
STEP_TIMEOUT_MS=15000
# Viewport for tools that run without a device profile (the recorder).
VIEWPORT_WIDTH=390
VIEWPORT_HEIGHT=844
DEVICE_SCALE_FACTOR=2

# --- LLM (optional; only for discovery drafts + doc prose) --------------------
# Never used in the per-step execution loop.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
# Discovery's LLM draft proposal sends the discovered screen's page HTML and a
# screenshot, which can contain personal data. Personal data must never reach
# the LLM, so it stays off (deterministic draft) unless set to true.
DISCOVERY_LLM_SEND_PAGE_CONTENT=false
