# ─────────────────────────────────────────────────────────────────────────────
# RosiFit App Screenshot Capture — environment
# Copy to `.env` and fill in. `.env` is gitignored: the PIN below signs in to a
# REAL account on the live app, so it must never be committed anywhere.
# ─────────────────────────────────────────────────────────────────────────────

# --- Target app --------------------------------------------------------------
# RosiFit has one deployment and one Supabase project. There is no TEST
# environment; this project is READ-ONLY against the live app instead.
APP_URL=https://rosi-fit.vercel.app
# The safety gate refuses any host not in this list. Add a preview deployment
# host here if you want to capture a branch build.
ALLOWED_APP_HOSTS=rosi-fit.vercel.app,localhost,127.0.0.1

# --- Super admin sign-in (mobile number + 4-digit PIN) -----------------------
# The number is a sign-in ID and is shown on the PIN screen anyway; the PIN is
# a secret. The runner redacts the PIN from run manifests and logs.
SIGNIN_MOBILE=
SIGNIN_PIN=

# --- Staff sign-in (optional) -------------------------------------------------
# A staff account lands on the Attendance workspace instead of Overview. Flows
# with `auth: staff` are skipped (with a reason) until both are set.
# STAFF_MOBILE=
# STAFF_PIN=

# --- Fixed identities (optional) ---------------------------------------------
# Flows default to prefix selectors ("the first course card"). Set these to pin
# a flow to one record, so a newly added course cannot shift what is captured.
FIXED_COURSE_ID=
FIXED_MEMBER_ID=

# --- App repo (for the git-diff change-detection layer) ----------------------
# Absolute path to a clone of https://github.com/UniqBrio/RosiFit. If unset or
# missing, change detection degrades gracefully to DOM-fingerprint-only (every
# flow runs every day).
# On Windows: do NOT wrap this in double quotes — dotenv treats quoted values
# specially and silently strips backslashes. Use forward slashes instead.
APP_REPO_PATH=
APP_REPO_BRANCH=main

# --- Behaviour ---------------------------------------------------------------
# Prune runs/ entries older than this many days (0 = keep forever).
RUNS_RETENTION_DAYS=30
# Playwright
HEADLESS=true
# Mobile-first PWA (Pixel-7-class). Desktop 1280x900 is the `desktop` named
# viewport preset, not the default.
VIEWPORT_WIDTH=390
VIEWPORT_HEIGHT=844
# Retina density for crisp documentation screenshots.
DEVICE_SCALE_FACTOR=2
# The OS colour scheme the browser reports. Only matters once "System" is
# chosen under Appearance; pinned so that choice is deterministic.
COLOR_SCHEME=dark
SLOW_MO_MS=0
STEP_TIMEOUT_MS=15000

# --- LLM (optional; only for discovery classification + doc prose) -----------
# Never used in the per-step execution loop.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
