# secrets — shared settings (root) and per-app credentials (apps/<app-id>/.env)
.env
.env.local
*.key

# App profiles are local: they hold real hosts, selectors, flows and saved
# sessions. Only the documented template is committed.
apps/*
!apps/_template/
apps/_template/.env
apps/_template/.auth/

# saved browser sessions — live sessions for real accounts
.auth/
storage-state.json

# throwaway recon (src/_recon.ts) and its output — regenerate, never commit
src/_recon.ts
.recon/

# throwaway environment probe — regenerate, never commit
src/_env-probe.ts

# node
node_modules/
dist/
npm-debug.log*
*.tsbuildinfo

# playwright
playwright-report/
test-results/
blob-report/

# os
Thumbs.db
.DS_Store

# Capture output: runs/<app-id>/<run-id>/<Device>/… — screenshots of real
# accounts, never committed. The fingerprint baseline in apps/<app-id>/ is the
# change signal.
runs/*
!runs/README.md

# user manual pipeline — raw evidence frames and JSON can hold personal data;
# the DOCX is a release artifact, not a repo file
evidence/
manual/build/*/images/
manual/build/**/*.docx
