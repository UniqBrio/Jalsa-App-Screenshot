# secrets — shared settings (root) and per-app credentials (apps/<app-id>/.env)
.env
.env.local
*.key

# App profiles are committed — app.config.json, flows/ and config/ (routes,
# inventories, coverage exceptions and backlog) are what CI audits, and none of
# them holds a secret. What stays on the capturing machine: credentials, saved
# sessions, and machine-written state.
apps/*/.env
apps/*/.auth/
apps/*/fingerprints/
apps/*/recordings/
apps/*/docs/
!apps/_template/fingerprints/
!apps/_template/recordings/

# saved browser sessions — live sessions for real accounts
.auth/
storage-state.json

# throwaway recon (src/_recon.ts) and its output — regenerate, never commit
src/_recon.ts
.recon/

# throwaway environment probe — regenerate, never commit
src/_env-probe.ts

# node
node_modules/
dist/
npm-debug.log*
*.tsbuildinfo

# playwright
playwright-report/
test-results/
blob-report/

# os
Thumbs.db
.DS_Store

# Capture output: runs/<app-id>/<run-id>/<Device>/… — screenshots of real
# accounts, never committed. The fingerprint baseline in apps/<app-id>/ is the
# change signal.
runs/*
!runs/README.md

# Coverage and audit reports — regenerated on every run, uploaded by CI.
reports/

# user manual pipeline — raw evidence frames and JSON can hold personal data;
# the DOCX is a release artifact, not a repo file
evidence/
manual/build/*/images/
manual/build/**/*.docx
