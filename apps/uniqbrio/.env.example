# ─────────────────────────────────────────────────────────────────────────────
# UniqBrio credentials. Copy to apps/uniqbrio/.env (gitignored — the ONLY place
# credentials are read from). Use a TEST account only; this profile is read-only.
# ─────────────────────────────────────────────────────────────────────────────

# --- owner: mobile number + the 4-digit OTP the TEST environment accepts -------
OWNER_MOBILE=
OWNER_OTP=

# --- Optional overrides ----------------------------------------------------------
# APP_URL=
# Local clone of github.com/UniqBrio/UniqBrio-Mobile-App (private). Used by the
# capture skip filter AND by `npm run coverage`. Forward slashes, no quotes.
# APP_REPO_PATH=
# APP_REPO_BRANCH=main
