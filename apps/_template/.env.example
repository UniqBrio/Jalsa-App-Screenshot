# ─────────────────────────────────────────────────────────────────────────────
# Credentials for ONE app. Copy to apps/<app-id>/.env and fill in.
#
# apps/<app-id>/.env is gitignored and is the ONLY place credentials are read
# from — not the root .env, not the shell. The runner redacts every login and
# secret named in app.config.json `accounts` from run manifests, logs and docs.
# Never paste a value into a flow, a commit, a screenshot or a chat.
#
# The variable names below must match `accounts` in app.config.json.
# ─────────────────────────────────────────────────────────────────────────────

# --- admin: a real account, permanently read-only -----------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- dummy: the dummy account in its own separate test tenant -----------------
# The only identity that may write, and only when WRITE_MODE=dummy and every
# other gate holds (see app.config.json dummyAccount).
DUMMY_EMAIL=
DUMMY_PASSWORD=

# --- Write mode (optional) ----------------------------------------------------
# off (default) or dummy. Dummy write flows are skipped unless this is dummy.
# WRITE_MODE=off

# --- Optional overrides -------------------------------------------------------
# A preview deployment instead of baseUrl. Its host must be in allowedHosts.
# APP_URL=
# Local clone of the app repo, for the git-diff skip filter. On Windows use
# forward slashes and no quotes (dotenv strips backslashes in quoted values).
# APP_REPO_PATH=
# APP_REPO_BRANCH=main
